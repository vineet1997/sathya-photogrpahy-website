---
import { Image } from 'astro:assets';
import script from '../assets/logo-script.png';
import SocialIcons from './SocialIcons.astro';
import { nav, site, whatsappHref } from '../data/site';

// Split nav either side of the centred script wordmark.
const left = nav.slice(0, 2);
const right = nav.slice(2);
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <nav class="primary-nav primary-nav--left" aria-label="Primary">
      <ul class="reset primary-nav__list">
        {left.map((item) => (
          <li><a href={item.href} class="primary-nav__link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <Image src={script} alt="" widths={[220, 440]} sizes="150px" loading="eager" class="brand__script" />
      <span class="brand__sub">Photography · Est. {site.founded}</span>
    </a>

    <nav class="primary-nav primary-nav--right" aria-label="Secondary">
      <ul class="reset primary-nav__list">
        {right.map((item) => (
          <li><a href={item.href} class="primary-nav__link">{item.label}</a></li>
        ))}
      </ul>
      <SocialIcons size={17} class="primary-nav__social" />
    </nav>

    <button class="menu-toggle" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="overlay-menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="overlay-menu" id="overlay-menu" data-overlay hidden>
  <button class="menu-toggle menu-toggle--close" data-menu-close aria-label="Close menu">
    <span></span><span></span>
  </button>
  <nav class="overlay-menu__nav" aria-label="Overlay">
    <ul class="reset">
      <li><a href="/" class="overlay-menu__link">Home</a></li>
      {nav.map((item) => (
        <li><a href={item.href} class="overlay-menu__link">{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="overlay-menu__foot">
    <a href={whatsappHref()} target="_blank" rel="noopener">WhatsApp</a>
    <a href={site.phone.href}>{site.phone.label}</a>
    <SocialIcons size={22} class="overlay-menu__social" />
  </div>
</div>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-block: clamp(1.2rem, 2.2vw, 1.9rem);
  }
  .site-header__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  /* Centred script wordmark */
  .brand {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    color: var(--ink);
  }
  .brand :global(.brand__script) {
    width: clamp(108px, 10vw, 150px);
    height: auto;
  }
  .brand__sub {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-size: 0.56rem;
    color: var(--green-deep);
    padding-left: var(--tracking-wider);
  }

  /* Desktop nav */
  .primary-nav--right { justify-self: end; display: flex; align-items: center; }
  /* hairline divider between the nav links and the icons */
  .primary-nav--right :global(.primary-nav__social) {
    margin-left: clamp(1.2rem, 2vw, 2rem);
    padding-left: clamp(1.2rem, 2vw, 2rem);
    border-left: 1px solid var(--line);
    gap: 0.85rem;
    color: var(--ink);
  }
  .primary-nav__list {
    display: flex;
    gap: clamp(1.4rem, 2.6vw, 2.8rem);
    align-items: center;
  }
  .primary-nav__link {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink);
    position: relative;
    padding-bottom: 0.25rem;
  }
  .primary-nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    height: 1px; width: 100%;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }
  .primary-nav__link:hover::after { transform: scaleX(1); transform-origin: left; }

  /* Hamburger */
  .menu-toggle {
    display: none;
    width: 30px; height: 22px;
    position: relative;
    flex: none;
  }
  .menu-toggle span {
    position: absolute;
    left: 0; right: 0;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease);
  }
  .menu-toggle span:nth-child(1) { top: 4px; }
  .menu-toggle span:nth-child(2) { top: 13px; right: 8px; }

  /* Overlay menu */
  .overlay-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--paper);
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .overlay-menu[hidden] { display: none; }
  .overlay-menu.is-open { opacity: 1; }
  .menu-toggle--close {
    display: block;
    position: absolute;
    top: clamp(1.6rem, 3vw, 2.4rem);
    right: var(--gutter);
    width: 26px; height: 26px;
  }
  .menu-toggle--close span { top: 12px; }
  .menu-toggle--close span:nth-child(1) { transform: rotate(45deg); }
  .menu-toggle--close span:nth-child(2) { transform: rotate(-45deg); right: 0; }

  .overlay-menu__nav ul {
    display: grid;
    gap: clamp(1rem, 3.2vw, 1.7rem);
    text-align: center;
  }
  .overlay-menu__link {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 8vw, 3.2rem);
    color: var(--ink);
    transition: color 0.35s var(--ease);
  }
  .overlay-menu__link:hover { color: var(--green-deep); font-style: italic; }
  .overlay-menu__foot {
    align-self: end;
    padding-bottom: clamp(2rem, 6vw, 3.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    padding-inline: var(--gutter);
    align-items: center;
  }
  .overlay-menu__foot :global(.overlay-menu__social) { gap: 1.1rem; color: var(--ink); }

  @media (max-width: 900px) {
    .primary-nav { display: none; }
    .menu-toggle { display: block; justify-self: end; }
    .site-header__inner { grid-template-columns: 30px 1fr 30px; }
    .brand { grid-column: 2; }
    .menu-toggle { grid-column: 3; }
  }
</style>

<script>
  function initMenu() {
    const overlay = document.querySelector<HTMLElement>('[data-overlay]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (!overlay || !openBtn) return;

    const open = () => {
      overlay.hidden = false;
      requestAnimationFrame(() => overlay.classList.add('is-open'));
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.classList.remove('is-open');
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      window.setTimeout(() => { overlay.hidden = true; }, 500);
    };

    openBtn.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
