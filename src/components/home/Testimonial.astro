---
// Kind words — real client testimonials only (see `testimonials` in site.ts).
import { testimonials } from '../../data/site';
---

<section class="kind section">
  <div class="container kind__inner">
    <p class="eyebrow reveal">Kind words</p>
    {testimonials.map((t) => (
      <figure class="kind__item reveal">
        <blockquote class="kind__quote">“{t.quote}”</blockquote>
        <figcaption class="kind__by">— {t.by}</figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .kind__inner {
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    justify-items: center;
  }
  .kind__inner > .eyebrow { color: var(--green-deep); margin-bottom: -1rem; }
  .kind__item { display: grid; gap: 1.6rem; justify-items: center; margin: 0; }
  .kind__quote {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-style: italic;
    line-height: 1.3;
    text-wrap: balance;
  }
  .kind__by {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--stone);
  }
</style>
