---
import { whatsappHref } from '../data/site';

interface Props {
  line: string;
  label?: string;
}
const { line, label = 'Check your date' } = Astro.props;
---

<section class="section cta-band">
  <div class="container cta-band__inner reveal">
    <p class="cta-band__line" set:html={line}></p>
    <div class="cta-band__actions">
      <a href="/contact/" class="btn">{label}</a>
      <a href={whatsappHref()} class="cta" target="_blank" rel="noopener">or WhatsApp us</a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    text-align: center;
    display: grid;
    gap: 1.8rem;
    justify-items: center;
    border-top: 1px solid var(--line-soft);
    padding-top: clamp(3rem, 8vw, 6rem);
  }
  .cta-band__line { font-family: var(--font-display); font-size: var(--fs-h1); line-height: 1.1; max-width: 20ch; }
  .cta-band__line :global(em) { color: var(--green-deep); }
  .cta-band__actions { display: flex; gap: 1.8rem; align-items: center; flex-wrap: wrap; justify-content: center; }
</style>
