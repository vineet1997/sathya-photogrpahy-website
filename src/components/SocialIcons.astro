---
// Instagram / YouTube / Facebook icon links. Icons inherit `currentColor`.
import { site } from '../data/site';

type Network = 'instagram' | 'youtube' | 'facebook';
interface Props {
  networks?: Network[];
  /** Icon size in px */
  size?: number;
  class?: string;
}
const { networks = ['instagram', 'youtube'], size = 18, class: cls = '' } = Astro.props;

const links: Record<Network, { label: string; href: string }> = {
  instagram: { label: `Instagram ${site.instagram.handle}`, href: site.instagram.url },
  youtube: { label: 'YouTube — wedding films', href: site.youtube },
  facebook: { label: 'Facebook', href: site.facebook },
};
---

<ul class={`social reset ${cls}`}>
  {networks.map((n) => (
    <li>
      <a class="social__link" href={links[n].href} target="_blank" rel="noopener" aria-label={links[n].label} title={links[n].label}>
        {n === 'instagram' && (
          <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" />
          </svg>
        )}
        {n === 'youtube' && (
          <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="2.5" y="5" width="19" height="14" rx="4" />
            <path d="M10.2 9.2v5.6l4.8-2.8z" fill="currentColor" stroke="none" />
          </svg>
        )}
        {n === 'facebook' && (
          <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M13.2 21.4v-7.2h2.3l.4-2.7h-2.7V9.8c0-.8.3-1.3 1.4-1.3h1.4V6.1a17 17 0 0 0-2.1-.1c-2 0-3.4 1.2-3.4 3.5v2h-2.3v2.7h2.3v7" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .social { display: flex; align-items: center; gap: 0.9rem; }
  .social__link {
    display: grid;
    place-items: center;
    color: inherit;
    transition: color 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .social__link:hover { color: var(--green-deep); transform: translateY(-1px); }
</style>
